# Production env for Hostinger KVM2 Docker stack.
# Copy to `.env` on the VPS (never commit real secrets):
#   cp .env.production.example .env
#
# Use a SEPARATE Atlas database from development (MONGODB_DB=wallbang).

NODE_ENV=production

NEXT_PUBLIC_SITE_URL=https://wallbang.xyz
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/KY2dRw8Yh4

# Optional per-server host overrides (defaults to prod IP for retake-1-mumbai).
# NEXT_PUBLIC_SERVER_HOST_RETAKE_1_MUMBAI=
# Legacy alias for retake-1-mumbai (prefer NEXT_PUBLIC_SERVER_HOST_*):
# NEXT_PUBLIC_RETAKE_HOST=

# --- Steam login ---
# https://steamcommunity.com/dev/apikey — Domain: wallbang.xyz
# AUTH_SECRET: openssl rand -base64 32
STEAM_API_KEY=
AUTH_SECRET=

# --- MongoDB ---
# Option A — Atlas (recommended for prod)
# Atlas → Database Access: user wallbang_app (readWrite on wallbang)
# Atlas → Network Access: allow the VPS public IP
# Atlas → Connect → Drivers → paste SRV URI below
#
# MONGODB_URI=mongodb+srv://wallbang_app:YOUR_PROD_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=wallbang
#
# Option B — in-stack Compose Mongo (default below)
# Requires MONGO_PASSWORD; password in MONGODB_URI must match.
MONGO_PASSWORD=CHANGE_ME_MONGO
MONGODB_URI=mongodb://wallbang:CHANGE_ME_MONGO@db:27017/wallbang?authSource=admin
MONGODB_DB=wallbang

SERVER_STATUS_TTL_SECONDS=15
SERVER_STATUS_DOC_TTL_SECONDS=120

# --- Permissions / admin ---
# Comma-separated SteamID64 values that receive OWNER on login (source: SYSTEM).
OWNER_STEAM_IDS=
# Shared secret for CS2 plugin → GET /api/v1/player/:steamId,
# POST /api/v1/presence, and POST /api/v1/catalog/cosmetics (header: X-API-Key).
PLUGIN_API_KEY=

# How long a player presence heartbeat stays "online" without refresh (seconds).
PLAYER_PRESENCE_TTL_SECONDS=90

# How long player_sessions docs are kept (Mongo TTL on joinedAt). Default 30.
PLAYER_SESSION_RETENTION_DAYS=30

# --- Launch VIP offer (Next.js) ---
# Default: Steam login alone grants VIP. Set GIVEAWAY_REQUIRE_DISCORD=true to also
# require Discord link + guild membership (Discord claim paths stay in the codebase).
# GIVEAWAY_REQUIRE_DISCORD=false
# GIVEAWAY_MAX_WINNERS=100
# GIVEAWAY_VIP_MONTHS=3
# Webhook: #launch-giveaway → Channel Settings → Integrations → Webhooks
# DISCORD_GIVEAWAY_WEBHOOK_URL=

# Discord OAuth (same app as the bot). Redirect:
# {NEXT_PUBLIC_SITE_URL}/api/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- Redis (optional — only with --profile redis or --profile discord) ---
# REDIS_PASSWORD=CHANGE_ME_REDIS
# REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379

# --- Optional Discord bot (--profile discord) ---
# Enable intents: Server Members
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# Also set PLUGIN_API_KEY so the bot can notify the site on guild joins.

# --- Razorpay prepaid VIP ---
# Add wallbang.xyz on the existing Razorpay account (Business Website Details).
# Live webhook: https://wallbang.xyz/api/webhooks/razorpay
# Events: payment.captured, order.paid, payment.failed, refund.processed,
#         dispute.created, dispute.lost
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- PayU prepaid VIP (PayU Hosted Checkout) ---
# Live webhook: https://wallbang.xyz/api/webhooks/payu
# Events: Successful, Failed, Refund
# PAYMENT_PROVIDER=payu
# PAYU_MERCHANT_KEY=
# PAYU_MERCHANT_SALT=
# PAYU_ENV=production

# --- VIP pricing (amounts in paise, INR) ---
# Individual-server defaults when a server has no custom admin pricing:
# VIP_SERVER_PRICE_1M_PAISE=9900      # ₹99
# VIP_SERVER_PRICE_3M_PAISE=27900     # ₹279
# VIP_SERVER_PRICE_6M_PAISE=54900     # ₹549
# VIP_SERVER_PRICE_1Y_PAISE=99900     # ₹999
# All Retakes global pricing (separate from per-server admin pricing):
# VIP_ALL_RETAKES_1M_PAISE=14900      # ₹149
# VIP_ALL_RETAKES_3M_PAISE=39900      # ₹399
# VIP_ALL_RETAKES_6M_PAISE=79900      # ₹799
# VIP_ALL_RETAKES_1Y_PAISE=169900     # ₹1,699
# Checkout CTA is off by default in production builds; admin can enable in Settings.
# FEATURE_VIP_CHECKOUT=false
# FEATURE_VIP_ALL_RETAKES=false
