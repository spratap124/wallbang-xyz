# WallBang MongoDB backup configuration
#
# Installed to: /etc/wallbang-backup/backup.env  (mode 0600, root-owned)
# This file contains secrets. Never commit a filled-in copy to Git.
#
# The installer copies this template to the config path ONLY if it does not
# already exist, so re-running the installer never overwrites your secrets.

# ---------------------------------------------------------------------------
# MongoDB Atlas (required)
# ---------------------------------------------------------------------------
# Dedicated least-privilege Atlas user, e.g. role "readAnyDatabase" on the
# cluster (backup-only). Never reuse the application's readWrite user.
# Quote the value; it contains characters that the shell would otherwise eat.
MONGODB_URI='mongodb+srv://wallbang_backup:REPLACE_ME@cluster0.xxxxx.mongodb.net/?retryWrites=false&appName=wallbang-backup'

# Optional: restrict the dump to specific databases (space separated).
# Leave empty to dump every database the backup user can read.
MONGODB_DATABASES=''

# ---------------------------------------------------------------------------
# Backblaze B2 + rclone crypt remote (required)
# ---------------------------------------------------------------------------
# RCLONE_CRYPT_REMOTE is the *crypt* remote name from your rclone config
# (created with `rclone config create <name> crypt remote=<b2-remote>:<bucket> ...`).
# Backups are written to <crypt>:<RCLONE_PATH>/<timestamp>/...
RCLONE_CRYPT_REMOTE='wallbang-backup-crypt'
RCLONE_PATH='mongodb'

# ---------------------------------------------------------------------------
# Retention / limits
# ---------------------------------------------------------------------------
# Local + off-site retention in days. Older backups are pruned only after the
# new backup has been uploaded and verified.
RETENTION_DAYS=30
# Abort before dumping when free space in LOCAL_BACKUP_DIR is below this.
MIN_FREE_DISK_MB=512

# ---------------------------------------------------------------------------
# Paths (absolute; override only if your distribution differs)
# ---------------------------------------------------------------------------
MONGODUMP_BIN=/usr/bin/mongodump
MONGORESTORE_BIN=/usr/bin/mongorestore
RCLONE_BIN=/usr/bin/rclone
FLOCK_BIN=/usr/bin/flock
SHA256_BIN=/usr/bin/sha256sum
GZIP_BIN=/bin/gzip
CURL_BIN=/usr/bin/curl

LOCAL_BACKUP_DIR=/var/backups/wallbang-mongodb
LOG_FILE=/var/log/wallbang-backup/backup.log
BACKUP_LOCK_FILE=/var/lock/wallbang-mongodb-backup.lock
BACKUP_PREFIX=mongodb

# ---------------------------------------------------------------------------
# Verification
# ---------------------------------------------------------------------------
# Validate each archive with `mongorestore --dryRun` before uploading.
VALIDATE_ARCHIVE=true
# Additionally download the uploaded archive and compare bytes (slower).
VERIFY_DOWNLOAD=false

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# WallBang Discord webhook (never logged). Leave empty to disable.
DISCORD_WEBHOOK_URL=''
NOTIFY_ON_SUCCESS=false

# ---------------------------------------------------------------------------
# rclone config decryption (optional but recommended)
# ---------------------------------------------------------------------------
# The systemd unit sets RCLONE_CONFIG=/etc/wallbang-backup/rclone.conf because
# ProtectHome hides /root. Create the rclone remotes there, e.g.:
#   sudo rclone --config /etc/wallbang-backup/rclone.conf config ...
# RCLONE_CACHE_DIR keeps rclone's cache on a writable, hardened-safe path.
RCLONE_CONFIG='/etc/wallbang-backup/rclone.conf'
RCLONE_CACHE_DIR='/var/cache/wallbang-backup'

# If your rclone.conf is encrypted (RCLONE_CONFIG_PASS), start rclone with
# --password-command so the passphrase is never stored in the config or argv:
#   RCLONE_CONFIG_PASS_COMMAND='/usr/bin/cat /etc/wallbang-backup/rclone-pass'
# The referenced helper file must be root-owned mode 0600.
RCLONE_CONFIG_PASS_COMMAND=''
